{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "packageManager": "pnpm",
  "mutate": [
    "lib/schemas/auth.ts",
    "lib/schemas/city.ts",
    "lib/schemas/pagination.ts",
    "lib/schemas/weather.ts",
    "lib/model-config.ts",
    "lib/schemas/ai.ts",
    "lib/schemas/ai-agent.ts",
    "lib/schemas/forecast-agent.ts",
    "lib/schemas/a2ui.ts",
    "lib/schemas/a2ui-catalog.ts",
    "lib/utils.ts",
    "lib/weather/actions.ts",
    "lib/weather/city-actions.ts",
    "lib/weather/errors.ts",
    "lib/weather/http.ts",
    "lib/weather/sse.ts",
    "lib/weather/daily.ts",
    "lib/weather/mapping.ts",
    "lib/weather/pagination.ts",
    "lib/weather/pipeline.ts",
    "lib/weather/providers/index.ts",
    "lib/weather/providers/open-meteo.ts",
    "lib/weather/providers/openweather.ts",
    "lib/weather/providers/weatherapi.ts",
    "lib/weather/resolve-city.ts",
    "lib/ai-agent/db/conversation-actions.ts",
    "lib/ai-agent/agent/prompt.ts",
    "lib/ai-agent/agent/tools.ts",
    "lib/ai-agent/a2ui/forecast-card.ts",
    "lib/ai-agent/a2ui/capture.ts",
    "lib/ai-agent/common/errors.ts",
    "lib/ai-agent/common/route-helpers.ts",
    "lib/forecast-agent/common/errors.ts",
    "lib/forecast-agent/engine/ensemble.ts",
    "lib/forecast-agent/engine/weights.ts",
    "lib/agent-core/chat.ts",
    "lib/agent-core/chat-stream.ts",
    "lib/agent-core/dns.ts",
    "lib/agent-core/ssrf.ts",
    "lib/agent-core/react.ts",
    "lib/agent-core/react-stream.ts",
    "lib/agent-core/orchestrator.ts",
    "lib/schemas/agent-core.ts",
    "lib/forecast-agent/agent/tools.ts",
    "lib/forecast-agent/agent/specialists.ts",
    "lib/forecast-agent/engine/divergence.ts",
    "lib/forecast-agent/engine/truth.ts",
    "lib/forecast-agent/db/db.ts",
    "lib/forecast-agent/stream/stream.ts",
    "supabase/auth/actions.ts",
    "supabase/auth/errors.ts",
    "supabase/proxy.ts",
    "supabase/server.ts",
    "supabase/service.ts"
  ],
  "coverageAnalysis": "perTest",
  "timeoutMS": 10000,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/stryker/html/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/stryker/mutation-report.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  }
}
