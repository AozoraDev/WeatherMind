# Supabase 项目连接配置（复制为 .env.local 后填入真实值）
# 在 Supabase Dashboard → Project Settings → API 中获取

# 项目 API 地址，形如 https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 公开的 anon 密钥（可安全暴露给浏览器，受 Row Level Security 约束）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 服务端专用 service_role 密钥（cron 采集 / 城市增删等写入用，绕过 RLS；不加 NEXT_PUBLIC_ 前缀）
# 在 Supabase Dashboard → Project Settings → API → service_role 获取，仅配到服务端环境（如 Vercel）
SUPABASE_SERVICE_ROLE_KEY=

# 天气数据源密钥（服务端专用，不加 NEXT_PUBLIC_ 前缀）
# Open-Meteo 免费免 key；OpenWeatherMap / WeatherAPI.com 需要申请
# - OpenWeatherMap: https://home.openweathermap.org/api_keys
# - WeatherAPI: https://www.weatherapi.com/signup.aspx
OPENWEATHER_API_KEY=
WEATHERAPI_API_KEY=

# 外部定时任务调用 /api/cron/weather 的校验头（如 Vercel Cron 环境变量），
# 未配置时该路由一律返回 401（安全默认）
# 可以不填，留空
WEATHER_CRON_SECRET=
